{
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "network": {
      "type": "object",
      "properties": {
        "bind": {
          "enum": [
            "loopback",
            "tailnet"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "properties": {
        "pollSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "leaseSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "leaseGraceSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "quietHours": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "provider": {
            "const": "fake"
          },
          "connection": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "access": {
                  "enum": [
                    "read",
                    "write"
                  ]
                },
                "write": {
                  "type": "boolean"
                },
                "maxCalls": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxCost": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "access"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "maxCalls": {
            "type": "integer",
            "minimum": 1
          },
          "maxCost": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "provider",
          "connection",
          "tools"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxConcurrentWorkers": {
          "type": "integer",
          "minimum": 1
        },
        "maxWorkersPerDay": {
          "type": "integer",
          "minimum": 1
        },
        "maxAttemptsPerItem": {
          "type": "integer",
          "minimum": 1
        },
        "itemMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "maxTurns": {
          "type": "integer",
          "minimum": 1
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 1
        },
        "tokenBudget": {
          "type": "integer",
          "minimum": 1
        },
        "maxMergesPerDay": {
          "type": "integer",
          "minimum": 1
        },
        "dailyDollars": {
          "type": "number",
          "minimum": 0
        },
        "dailyTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "github-issues",
              "github-prs",
              "local-files"
            ]
          },
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "trustedAuthors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "blockedAuthors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "updatedBefore": {
            "type": "number",
            "minimum": 0
          },
          "own": {
            "type": "boolean"
          },
          "glob": {
            "type": "string"
          },
          "statusField": {
            "type": "string"
          },
          "readyValue": {
            "type": "string"
          },
          "requiredLabels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "maxItems": {
            "type": "integer",
            "minimum": 1
          },
          "maxAttempts": {
            "type": "integer",
            "minimum": 1
          },
          "maxSize": {
            "type": "integer",
            "minimum": 1
          },
          "maxAgeMs": {
            "type": "integer",
            "minimum": 1
          },
          "checkout": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "repo"
        ],
        "additionalProperties": false
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "organization": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "profile": {
      "type": "string",
      "pattern": "^(?!\\.\\.?$)[A-Za-z0-9._-]+$"
    },
    "peers": {
      "type": "array",
      "maxItems": 0
    },
    "scope": {
      "type": "object",
      "properties": {
        "repos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "policySource": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1,
                    "default": "none"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false,
                "default": {
                  "kind": "none"
                }
              },
              "pipeline": {
                "type": "object",
                "properties": {
                  "stages": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "scout",
                        "spec",
                        "build",
                        "review",
                        "gate",
                        "handoff"
                      ]
                    },
                    "uniqueItems": true
                  },
                  "gates": {
                    "type": "object",
                    "properties": {
                      "specApproval": {
                        "type": "boolean"
                      },
                      "complexityThreshold": {
                        "enum": [
                          "medium",
                          "large"
                        ]
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  },
                  "improve": {
                    "type": "object",
                    "properties": {
                      "enabled": {
                        "type": "boolean",
                        "default": false
                      },
                      "repeatThreshold": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "base": {
                "type": "string"
              },
              "merge": {
                "type": "object",
                "properties": {
                  "mode": {
                    "enum": [
                      "human-approval",
                      "auto-when-safe",
                      "never"
                    ],
                    "default": "human-approval"
                  },
                  "shadow": {
                    "type": "boolean"
                  },
                  "tighten": {
                    "type": "object",
                    "properties": {
                      "maxFiles": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "maxChangedLines": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "maxRisk": {
                        "enum": [
                          "low",
                          "medium"
                        ]
                      },
                      "authors": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "uniqueItems": true
                      },
                      "baseBranches": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "uniqueItems": true
                      },
                      "pathAllow": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "uniqueItems": true
                      },
                      "pathDeny": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "uniqueItems": true
                      },
                      "methods": {
                        "type": "array",
                        "items": {
                          "enum": [
                            "squash",
                            "merge",
                            "rebase"
                          ]
                        }
                      },
                      "requiredChecks": {
                        "anyOf": [
                          {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "uniqueItems": true
                          },
                          {
                            "const": "github-required"
                          }
                        ]
                      },
                      "requireCrossFamilyReview": {
                        "type": "boolean"
                      },
                      "coolingOffMinutes": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "dailyCap": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "requireHumanApproval": {
                        "type": "boolean"
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  }
                },
                "required": [],
                "additionalProperties": false,
                "default": {
                  "mode": "human-approval"
                }
              }
            },
            "required": [
              "slug"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "properties": {
        "steward": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "family": {
              "type": "string"
            },
            "thinking": {
              "enum": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            }
          },
          "required": [
            "model"
          ],
          "additionalProperties": false
        },
        "worker": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "family": {
              "type": "string"
            },
            "thinking": {
              "enum": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            }
          },
          "required": [
            "model"
          ],
          "additionalProperties": false
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "family": {
                  "type": "string"
                },
                "thinking": {
                  "enum": [
                    "off",
                    "minimal",
                    "low",
                    "medium",
                    "high",
                    "xhigh"
                  ]
                }
              },
              "required": [
                "model"
              ],
              "additionalProperties": false
            },
            {
              "const": "auto"
            }
          ]
        },
        "judge": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "family": {
              "type": "string"
            },
            "thinking": {
              "enum": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            }
          },
          "required": [
            "model"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "merge": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "human-approval",
            "auto-when-safe",
            "never"
          ],
          "default": "human-approval"
        },
        "shadow": {
          "type": "boolean"
        },
        "tighten": {
          "type": "object",
          "properties": {
            "maxFiles": {
              "type": "integer",
              "minimum": 1
            },
            "maxChangedLines": {
              "type": "integer",
              "minimum": 1
            },
            "maxRisk": {
              "enum": [
                "low",
                "medium"
              ]
            },
            "authors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "baseBranches": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "pathAllow": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "pathDeny": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "methods": {
              "type": "array",
              "items": {
                "enum": [
                  "squash",
                  "merge",
                  "rebase"
                ]
              }
            },
            "requiredChecks": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                {
                  "const": "github-required"
                }
              ]
            },
            "requireCrossFamilyReview": {
              "type": "boolean"
            },
            "coolingOffMinutes": {
              "type": "integer",
              "minimum": 0
            },
            "dailyCap": {
              "type": "integer",
              "minimum": 1
            },
            "requireHumanApproval": {
              "type": "boolean"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false,
      "default": {
        "mode": "human-approval"
      }
    },
    "chat": {
      "type": "object",
      "properties": {
        "startableKinds": {
          "type": "array",
          "items": {
            "enum": [
              "chat",
              "scout"
            ]
          }
        },
        "maxMessageBytes": {
          "type": "integer",
          "minimum": 1,
          "default": 1048576
        },
        "rateLimit": {
          "type": "object",
          "properties": {
            "perMinute": {
              "type": "integer",
              "minimum": 1
            },
            "perDay": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "workers": {
      "type": "object",
      "properties": {
        "dispatcher": {
          "enum": [
            "orca",
            "git-process"
          ]
        },
        "kind": {
          "enum": [
            "pi-session",
            "durable-conversation"
          ]
        },
        "roles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "pi-session",
                  "durable-conversation"
                ]
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "durable": {
          "type": "object",
          "properties": {
            "enabledRoles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "modelAuth": {
              "type": "boolean"
            },
            "maxConcurrent": {
              "type": "integer",
              "minimum": 1,
              "default": 2
            },
            "skills": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "viewer": {
              "enum": [
                "on-start",
                "on-demand",
                "never"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "notify": {
      "type": "object",
      "properties": {
        "staleDays": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          {
            "type": "object",
            "properties": {
              "channels": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "priority": {
                "enum": [
                  "low",
                  "normal",
                  "high"
                ]
              },
              "reminders": {
                "type": "object",
                "properties": {
                  "afterMinutes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "everyMinutes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": [
              "channels"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "profile"
  ],
  "additionalProperties": false
}
