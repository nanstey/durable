{
	"name": "@nanstey/durable",
	"version": "0.0.0",
	"private": true,
	"description": "Durable proactive agents built on pi-durable.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"bin/",
		"src/",
		"pi-extension/",
		"templates/",
		"schema/",
		"examples/",
		"units/",
		"README.md",
		"LICENSE"
	],
	"bin": {
		"durable": "bin/durable"
	},
	"scripts": {
		"schema:generate": "node --experimental-strip-types scripts/generate-schemas.ts",
		"test": "node --experimental-strip-types --test --test-timeout=90000 test/unit/*.test.ts test/contract/*.test.ts",
		"lint": "biome lint .",
		"format:check": "biome format .",
		"fallow": "fallow dead-code --fail-on-issues && fallow dupes --fail-on-issues",
		"check": "tsc --noEmit && pnpm lint && pnpm format:check && pnpm fallow",
		"hygiene": "bash scripts/hygiene-scan.sh"
	},
	"dependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@hono/node-server": "2.1.5",
		"ajv": "8.17.1",
		"citty": "0.2.2",
		"execa": "10.2.1",
		"hono": "4.13.13",
		"htm": "3.1.1",
		"ink": "8.0.0",
		"pino": "10.4.0",
		"preact": "10.27.2",
		"proper-lockfile": "4.1.2",
		"react": "19.3.1",
		"typebox": "1.4.3",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@types/node": "26.6.5",
		"@types/proper-lockfile": "4.1.4",
		"@types/react": "19.3.0",
		"fallow": "3.35.0",
		"typescript": "7.0.2"
	}
}
