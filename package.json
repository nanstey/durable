{
	"name": "@nanstey/durable",
	"version": "0.0.0",
	"private": true,
	"description": "Durable proactive agents built on pi-durable.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"bin/",
		"src/",
		"schema/",
		"examples/",
		"README.md",
		"LICENSE"
	],
	"bin": {
		"durable": "bin/durable"
	},
	"scripts": {
		"schema:generate": "node --experimental-strip-types scripts/generate-schemas.ts",
		"test": "node --experimental-strip-types --test test/unit/*.test.ts",
		"lint": "biome lint .",
		"format:check": "biome format .",
		"fallow": "fallow dead-code --fail-on-issues && fallow dupes --fail-on-issues",
		"check": "tsc --noEmit && pnpm lint && pnpm format:check && pnpm fallow",
		"hygiene": "bash scripts/hygiene-scan.sh"
	},
	"dependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"ajv": "8.17.1",
		"proper-lockfile": "4.1.2",
		"typebox": "1.4.3",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@types/node": "26.6.5",
		"@types/proper-lockfile": "4.1.4",
		"fallow": "3.35.0",
		"typescript": "7.0.2"
	}
}
